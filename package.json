{
  "name": "inside-the-runtime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/build.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "node --test src/webgl/geometry.test.mjs src/animation/scrollMotion.test.mjs",
    "test:browser": "playwright test --project=chrome --project=webkit",
    "test:browser:firefox": "playwright test --project=firefox",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fiddle-digital/string-tune": "^1.2.6",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "animejs": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
